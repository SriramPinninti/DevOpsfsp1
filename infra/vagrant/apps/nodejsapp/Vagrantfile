Vagrant.configure("2") do |config|

  config.vm.box = "bandit145/centos_stream9_arm"


  config.vm.define "nodejsapp_nginx" do |nodejsapp_nginx|
    nodejsapp_nginx.vm.provider "vmware_desktop" do |v|
       v.memory = "512"
    end

    nodejsapp_nginx.vm.network "private_network", ip: "192.168.134.124"
    nodejsapp_nginx.vm.hostname = 'nodejsapp-nginx'

    nodejsapp_nginx.vm.provision "shell", inline: <<-SHELL
      echo "Adding SSH Key"
      echo " ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPTSUU8n82kFQQJS/h5wqEOMXd1e7mW7+tpFM0rmhMF8 you@example.com" >> /home/vagrant/.ssh/authorized_keys
    
    SHELL
  end

  config.vm.define "nodejsapp_backend_1" do |nodejsapp_backend_1|
    nodejsapp_backend_1.vm.provider "vmware_desktop" do |v|
       v.memory = "512"
    end

    nodejsapp_backend_1.vm.network "private_network", ip: "192.168.134.125"
    nodejsapp_backend_1.vm.hostname = 'nodejsapp-backend-1'

    nodejsapp_backend_1.vm.provision "shell", inline: <<-SHELL
      echo "Adding SSH Key"
      echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPTSUU8n82kFQQJS/h5wqEOMXd1e7mW7+tpFM0rmhMF8 you@example.com" >> /home/vagrant/.ssh/authorized_keys

    SHELL
   end


    
  config.vm.define "nodejsapp_backend_2" do |nodejsapp_backend_2|
    nodejsapp_backend_2.vm.provider "vmware_desktop" do |v|
       v.memory = "512"
    end

    nodejsapp_backend_2.vm.network "private_network", ip: "192.168.134.126"
    nodejsapp_backend_2.vm.hostname = 'nodejsapp-backend-2'

    nodejsapp_backend_2.vm.provision "shell", inline: <<-SHELL
      echo "Adding SSH Key"
      echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPTSUU8n82kFQQJS/h5wqEOMXd1e7mW7+tpFM0rmhMF8 you@example.com" >> /home/vagrant/.ssh/authorized_keys 

    SHELL
   end


end
